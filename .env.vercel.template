# ═══════════════════════════════════════════════════════════════════════════════
# Variables de entorno para Vercel (producción)
# ═══════════════════════════════════════════════════════════════════════════════
#
#  Cómo usar:
#  1. Ir a Vercel → Project → Settings → Environment Variables
#  2. Por cada variable de abajo: "Add New" → pegar Name + Value
#  3. Marcar el environment correcto:
#       Production            → todas las marcadas como [PROD]
#       Preview + Production  → todas las marcadas como [PROD+PREVIEW]
#       Development           → solo si vas a usar `vercel dev` local
#  4. Después de pegar TODAS, ir a Deployments → Redeploy (sin cache) la última.
#
#  ⚠️  Variables MARCADAS COMO CRÍTICAS son las únicas obligatorias para que
#      arranque la app. El resto son opcionales (proveedores IA extra, etc.).
#
# ═══════════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────────
# 🔴 CRÍTICAS — Sin estas la app no arranca
# ───────────────────────────────────────────────────────────────────────────────

# [PROD+PREVIEW]  Groq es el proveedor IA principal. Sin esto no se genera nada.
# Obtener en: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# [PROD+PREVIEW]  Secret para firmar la cookie de sesión del estudiante.
# Generar UNA SOLA VEZ con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Usar el MISMO valor en preview y prod (si cambia, todos quedan desloguados).
AUTH_SECRET=

# [PROD+PREVIEW]  Contraseña del panel admin. NO usar "admin1234" en prod.
# Generar una random fuerte:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_PASSWORD=

# [PROD+PREVIEW]  Secret para firmar JWT de admin (puede ser igual que AUTH_SECRET o distinto).
ADMIN_JWT_SECRET=

# [PROD+PREVIEW]  Emails que tienen acceso al panel admin. Separados por coma.
# Ej: ADMIN_EMAILS=ron@empresa.com,otro@empresa.com
ADMIN_EMAILS=


# ───────────────────────────────────────────────────────────────────────────────
# 🟡 ALTAMENTE RECOMENDADAS — Sin estas usás in-memory (datos se pierden)
# ───────────────────────────────────────────────────────────────────────────────

# [PROD+PREVIEW]  Supabase URL. La obtenés en:
#   Supabase Dashboard → Project Settings → API → Project URL
# Para este proyecto: https://svaswbryumacbirecvjt.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://svaswbryumacbirecvjt.supabase.co

# [PROD+PREVIEW]  Anon key pública (sí, se expone al cliente — es por diseño).
# Obtenerla en: Supabase Dashboard → Project Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [PROD+PREVIEW]  Service role key. SECRETO TOTAL. Bypassea RLS.
# Obtenerla en: Supabase Dashboard → Project Settings → API → service_role
# ⚠️  Nunca commitear. Nunca poner en NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=


# ───────────────────────────────────────────────────────────────────────────────
# 🟢 OPCIONALES — Fallbacks IA y proveedores adicionales
# ───────────────────────────────────────────────────────────────────────────────

# [PROD+PREVIEW]  Anthropic (Claude) — fallback nº1 si Groq falla.
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# [PROD+PREVIEW]  OpenAI — fallback nº2.
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# [PROD+PREVIEW]  Google Gemini — usado para Plan Pro/Elite (RAG, 1M tokens).
# Obtener en: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=

# [PROD+PREVIEW]  DeepSeek — usado para Plan Estándar.
# Obtener en: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# [PROD+PREVIEW]  Otros proveedores soportados por modelRouter (todos opcionales)
MISTRAL_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=


# ───────────────────────────────────────────────────────────────────────────────
# 🔵 GOOGLE OAUTH (Login con Google) — opcional pero recomendado
# ───────────────────────────────────────────────────────────────────────────────
#
#  Si no las configurás, los estudiantes solo pueden entrar como "demo".
#
#  Cómo obtenerlas:
#  1. Ir a https://console.cloud.google.com
#  2. Crear proyecto (o usar uno existente)
#  3. APIs & Services → Credentials → "Create Credentials" → "OAuth client ID"
#  4. Application type: Web application
#  5. Authorized redirect URIs:
#       Producción: https://TU-DOMINIO.vercel.app/api/auth/callback/google
#       Preview:    https://TU-PROYECTO-git-BRANCH-TU-USUARIO.vercel.app/api/auth/callback/google
#       Localhost:  http://localhost:3000/api/auth/callback/google
#  6. Copiar Client ID y Secret y pegarlas abajo.
#
# ───────────────────────────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [PROD]  URL pública del callback en producción.
# OJO: debe coincidir EXACTO con lo que pusiste arriba en Google Cloud Console.
GOOGLE_REDIRECT_URI=https://TU-DOMINIO.vercel.app/api/auth/callback/google


# ───────────────────────────────────────────────────────────────────────────────
# ⚙️  RUNTIME (normalmente NO hace falta pegar nada acá)
# ───────────────────────────────────────────────────────────────────────────────

# Vercel ya pone NODE_ENV=production automáticamente.
# CHROME_PATH no aplica en serverless.
# STORE_PATH no aplica (filesystem es ephemeral en Vercel).
