{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/projects/generate-phase/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/projects/edit-phase-section/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/projects/finalize/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/projects/upload-document/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/projects/analyze-style/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/projects/[id]/qa/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/projects/[id]/analizar-observacion/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/projects/[id]/defensa/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/projects/[id]/preguntas/generar/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/projects/[id]/preguntas/pdf/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/projects/[id]/latex/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/projects/[id]/paquete-latex/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/projects/[id]/pdf/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/projects/[id]/defensa-materiales/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/axiom/plan-personalizado/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/axiom/examenes/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/axiom/simulador/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/admin/test-prompt-unifranz/route.ts": {
      "maxDuration": 90
    },
    "src/app/api/admin/projects/[id]/defensa-materiales/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/admin/descargar-latex/[id]/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/admin/pdf-solicitudes/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/compilar/[monografia_id]/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/export/latex/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/export/pdf/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/generate/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
