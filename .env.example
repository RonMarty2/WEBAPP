# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno para Laboratorio Académico PRO
#
# Copiá este archivo como `.env.local` para desarrollo y completá los valores.
# En Vercel: pegá las mismas claves en Project Settings → Environment Variables.
#
# 🚨 NUNCA commitees `.env.local` (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# === SECRETS DE AUTENTICACIÓN (obligatorios) ==================================
#
# Ambos firman JWT de sesión. Generalos con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Mínimo 32 caracteres. Si faltan o son demasiado cortos, la app NO arranca
# por seguridad (mejor un error visible que firmar con un secret conocido).

ADMIN_JWT_SECRET=
AUTH_SECRET=

# === GOOGLE OAUTH (obligatorio para login con Google) =========================
#
# Crear en Google Cloud Console → APIs & Services → Credentials.
# Tipo: "OAuth client ID" → Web application.
# Authorized redirect URIs:
#   - http://localhost:3000/api/auth/callback/google (dev)
#   - https://TU-DOMINIO/api/auth/callback/google    (prod)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# === PROVEEDORES DE IA (al menos UNO requerido) ===============================
#
# El sistema usa cascada: si uno falla, prueba el siguiente.
# Orden: Groq → Anthropic → OpenAI

GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# === SUPABASE (futuro — todavía no conectado, usa in-memory store) ============
#
# Cuando se conecte Supabase real, completar estas dos. Hasta entonces, el
# sistema usa un .store/data.json local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === PDF EN PRODUCCIÓN (opcional — solo si querés override del Chrome local) ==
#
# Por default el sistema busca Chrome/Edge en rutas conocidas del SO.
# En Vercel necesitarás @sparticuz/chromium o setear esta var.

CHROME_PATH=

# === ALMACENAMIENTO LOCAL (opcional) ==========================================
#
# Dónde se guarda el .store/data.json del modo in-memory. Si no se setea,
# usa `.store/` del directorio del proyecto.

STORE_PATH=
