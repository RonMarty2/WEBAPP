# ═══════════════════════════════════════════════════════════════════════════════
# Laboratorio Académico PRO — Configuración de Entorno (Environment Variables)
# ═══════════════════════════════════════════════════════════════════════════════

# ── AUTENTICACIÓN ──────────────────────────────────────────────────────────────

# JWT secret para firmar tokens (generar con: openssl rand -hex 32)
AUTH_SECRET=

# Google OAuth (configurar en https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin JWT (para rutas /api/admin/*)
ADMIN_JWT_SECRET=

# Admin credentials (restricción de acceso a panel admin)
ADMIN_PASSWORD=

# Emails permitidos como admin (separados por coma)
ADMIN_EMAILS=

# ── SUPABASE (Base de datos PostgreSQL) ────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── PROVEEDORES IA PRINCIPALES ─────────────────────────────────────────────────

# Groq — Principal (llama-3.3-70b-versatile)
# URL: https://console.groq.com
GROQ_API_KEY=

# Anthropic — Fallback 1 (claude-haiku-4-5)
# URL: https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI — Fallback 2 (gpt-4o-mini)
# URL: https://platform.openai.com
OPENAI_API_KEY=

# ── PROVEEDORES IA ADICIONALES (modelRouter) ──────────────────────────────────

# DeepSeek — usado para Plan Estándar (Bs. 150)
# URL: https://platform.deepseek.com
# Modelos: deepseek-chat, deepseek-coder
DEEPSEEK_API_KEY=

# Google Gemini — usado para Plan Pro (Bs. 300) y Elite (Bs. 500+)
# Gemini 2.5 Pro: contexto 1M tokens, ideal para Cap. II (marco teórico + RAG de PDFs)
# URL: https://aistudio.google.com
# Documentación: https://ai.google.dev
GEMINI_API_KEY=

# Mistral AI (mistral-large-latest)
# URL: https://console.mistral.ai
MISTRAL_API_KEY=

# Cohere (command-r-plus)
# URL: https://dashboard.cohere.com
COHERE_API_KEY=

# Together AI (meta-llama/Llama-3-70b-chat-hf)
# URL: https://www.together.ai
TOGETHER_API_KEY=

# Perplexity (sonar)
# URL: https://www.perplexity.ai
PERPLEXITY_API_KEY=

# X.AI Grok (grok-2)
# URL: https://console.x.ai
XAI_API_KEY=

# LM Studio (local model server, http://localhost:1234)
# Solo si usas servidor local en desarrollo
LMSTUDIO_API_KEY=

# ── CONFIGURACIÓN DE RUNTIME ───────────────────────────────────────────────────

# Entorno (development, production, staging)
NODE_ENV=development

# Ruta de almacenamiento para PDFs temporales (Linux/Mac)
STORE_PATH=/tmp/laboratorio-academico

# Ruta alternativa en Windows (PROGRAMFILES sustituido automáticamente)
# STORE_PATH=%PROGRAMFILES%\Laboratorio Académico

# Ruta de Chrome/Chromium para headless rendering de LaTeX
CHROME_PATH=/usr/bin/chromium

# ── NOTAS ──────────────────────────────────────────────────────────────────────
#
# 1. CLIENTE vs SERVIDOR:
#    - Variables con prefijo NEXT_PUBLIC_* están disponibles en el navegador
#    - Las demás solo están disponibles en el servidor (API routes)
#
# 2. CASCADA DE IA (ORDEN CRÍTICO):
#    1. Groq (principal) → 2. Anthropic (fallback 1) → 3. OpenAI (fallback 2)
#    Si Groq falla, reintentar con Anthropic. Si Anthropic falla, usar OpenAI.
#
# 3. PLANES Y MODELOS:
#    - Plan Estándar (Bs. 150): Groq + DeepSeek fallback
#    - Plan Pro (Bs. 300): Groq + Gemini 2.5 Pro (RAG avanzado)
#    - Plan Elite (Bs. 500+): Groq + Gemini 2.5 Pro + Anthropic Claude Opus
#
# 4. DESARROLLO LOCAL:
#    - Copiar este archivo a .env.local
#    - Llenar solo las claves que vayas a usar
#    - .env.local NO se commitea (está en .gitignore)
#
# 5. PRODUCCIÓN (Vercel):
#    - Configurar en Project Settings → Environment Variables
#    - Variables sensibles: ADMIN_JWT_SECRET, AUTH_SECRET, todas las API keys
#
# ═══════════════════════════════════════════════════════════════════════════════
